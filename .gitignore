# Node modules (both frontend + backend)
node_modules/
**/node_modules/

# Build output
dist/
frontend/dist/
backend/dist/
build/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# OS / Editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/

# Environment variables (VERY important!)
.env
.env.local
.env.development
.env.production
.env.test
**/.env

# Vite cache
frontend/.vite/
frontend/vite.config.ts.timestamp-*

# Optional: If using TypeScript in backend or frontend
*.tsbuildinfo

# Optional: If using PM2 or other process managers
.pids
*.pid
*.seed
*.pid.lock

# Optional: Ignore coverage output
coverage/

# Optional: Ignore lockfiles if you don't want to commit them
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

